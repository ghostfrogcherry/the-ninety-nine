# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Postgres -----------------------------------------------------------
POSTGRES_DB=ninetynine
POSTGRES_USER=ninetynine
# Required. No default on purpose — compose fails fast if this is unset.
POSTGRES_PASSWORD=change-me

# --- App ----------------------------------------------------------------
# 3010 avoids every port a typical arr stack already publishes
# (3000, 5055, 6767, 7878, 8080, 8096, 8686, 8989, 9696).
APP_PORT=3010

# 0.0.0.0 is fine on a Tailscale-only host. Set to 127.0.0.1 when running the
# Caddy override, so only the proxy can reach the app.
APP_BIND=0.0.0.0

# Auth.js v5. Generate with:  openssl rand -base64 32
AUTH_SECRET=change-me

# Must match the URL you actually browse to, scheme included, or sign-in
# redirects break in ways that look like a broken login form.
#
# It is also the origin every emailed link is built from — magic-link sign-in
# and password reset both. The Host header is deliberately NOT used for that: a
# request carrying someone else's Host would otherwise mail a real user a link
# pointing at someone else's server. Unset, no link is sent at all.
#
# The default is right for trying it on the machine you are sitting at. A
# placeholder hostname here used to send a first sign-in to a server that does
# not exist. On the real box, change it to the address you browse to, e.g.
# http://your-server.your-tailnet.ts.net:3010
AUTH_URL=http://localhost:3010

TZ=America/Chicago

# --- Email: magic-link sign-in and password reset (optional) ------------
# Both features share one mail setting, so they appear and disappear together.
# Mail stays OFF unless EMAIL_FROM *and* a destination are set. A
# half-configured mailer is worse than an absent one: sign-in would offer a
# magic link that silently never arrives. With these unset the app boots fine,
# the sign-in page hides the magic-link form, and /reset says plainly that
# there is no mail and points at scripts/set-password.mjs instead.
# EMAIL_FROM=cards@example.com
# SMTP_URL=smtp://user:pass@host:587
#   ...or the discrete form:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Capture destination — no SMTP server required. Every message this app would
# send is written to this directory as a .eml file and nothing is dialled; the
# app logs the file path (never the link itself, which signs someone in). This
# is how to exercise magic-link sign-in or a password reset on a box that has
# no mail server, which is most of them. SMTP wins if both are configured, so
# leaving this set cannot swallow real mail later.
# MAIL_CAPTURE_DIR=/data/mail

# --- Caddy (only for docker-compose.proxy.yml) --------------------------
# DOMAIN=cards.example.com
