# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Postgres -----------------------------------------------------------
POSTGRES_DB=ninetynine
POSTGRES_USER=ninetynine
# Required. No default on purpose — compose fails fast if this is unset.
POSTGRES_PASSWORD=change-me

# --- App ----------------------------------------------------------------
# 3010 avoids every port a typical arr stack already publishes
# (3000, 5055, 6767, 7878, 8080, 8096, 8686, 8989, 9696).
APP_PORT=3010

# 0.0.0.0 is fine on a Tailscale-only host. Set to 127.0.0.1 when running the
# Caddy override, so only the proxy can reach the app.
APP_BIND=0.0.0.0

# Auth.js v5. Generate with:  openssl rand -base64 32
AUTH_SECRET=change-me

# Must match the URL you actually browse to, scheme included, or sign-in
# redirects break in ways that look like a broken login form.
AUTH_URL=http://your-server.your-tailnet.ts.net:3010

TZ=America/Chicago

# --- Magic-link email (optional) ----------------------------------------
# The email provider stays OFF unless EMAIL_FROM *and* a host/URL are set.
# A half-configured provider is worse than an absent one: sign-in would offer
# a magic link that silently never arrives. With these unset the app boots
# fine and the sign-in page simply hides the magic-link form.
# EMAIL_FROM=cards@example.com
# SMTP_URL=smtp://user:pass@host:587
#   ...or the discrete form:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# --- Caddy (only for docker-compose.proxy.yml) --------------------------
# DOMAIN=cards.example.com
